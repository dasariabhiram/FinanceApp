# === Supabase (Project Settings → API / Database) ===
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Transaction pooler (API / Netlify Functions) — port 6543 (TLS required)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# Session pooler (worker / migrations) — port 5432
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# === API (local Fastify; Netlify Functions use the same env vars in the UI) ===
PORT=3001
NODE_ENV=development
# Include your Netlify site URL + Expo web origins for mobile/web CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8888,https://YOUR_SITE.netlify.app

# === Web / Mobile (public only) ===
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
# Same-origin on Netlify; Vite proxies /api → :3001 in local dev
VITE_API_URL=/api

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Local: direct Fastify. Prod: https://YOUR_SITE.netlify.app/api
EXPO_PUBLIC_API_URL=http://localhost:3001

# === Deferred (add later) ===
# GEMINI_API_KEY=
# RESEND_API_KEY=
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=
# SENTRY_DSN=
