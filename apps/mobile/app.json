{
  "expo": {
    "name": "FinanceApp",
    "slug": "financeapp",
    "scheme": "financeapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dasariabhiram.financeapp"
    },
    "android": {
      "package": "com.dasariabhiram.financeapp"
    }
  }
}
